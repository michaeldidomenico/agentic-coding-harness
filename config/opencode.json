{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "default_agent": "AgentManager",
  "instructions": [
    "/workspaces/agentic-coding-harness/config/AGENTS.universal.md"
  ],
  "skills": [
    "/workspaces/agentic-coding-harness/config/skills"
  ],
  "providers": {
    "openrouter": {
      "name": "OpenRouter Proxy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "agent": {
    "AgentManager": {
      "mode": "primary",
      "model": "openrouter/stepfun/step-5-preview",
      "description": "Orchestrator hub and architecture planner.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "CodeExplorer": {
      "mode": "subagent",
      "model": "openrouter/zhipu/glm-5.3-flash",
      "description": "Read-only workspace cartographer.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "PlanVerifier": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-sonnet-5",
      "description": "Immutable security and risk gate.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "CodeExecutor": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "description": "Surgical write action engine.",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  }
}

{
  "name": "Agentic Coding Harness",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "remoteEnv": {
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "UNIVERSAL_AGENT_CONTRACT": "/workspaces/agentic-coding-harness/config/AGENTS.universal.md"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sqlite3 ~/.local/share/opencode/opencode.db 'VACUUM;' 2>/dev/null || true"
}
